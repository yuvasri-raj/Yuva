# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls (Crop AI, Plant Disease Detection, Chatbot, Soil AI).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY=""
AI_MODEL="gemini-3.7-flash"

# JWT Secret for farmer and admin session tokens
JWT_SECRET="agro_vision_secret_jwt_key_2026"

# Weather API key (e.g., OpenWeatherMap or AgroWeather - optional, graceful fallback included)
WEATHER_API_KEY=""

# Market Price API key (e.g., Agmarknet / e-NAM - optional, seed records fallback included)
MARKET_API_KEY=""

# Database URI (optional - uses high-performance embedded persistent JSON store if not set)
MONGODB_URI=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT="3000"

